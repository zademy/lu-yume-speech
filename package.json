{
  "name": "speech-to-text",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "eslint src && prettier --check \"src/**/*.ts\" \"*.html\" \"*.json\" \"src/**/*.css\" && tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.ts\" \"*.html\" \"*.json\" \"src/**/*.css\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.html\" \"*.json\" \"src/**/*.css\"",
    "prepare": "husky",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "pnpm audit --prod"
  },
  "lint-staged": {
    "*.{ts,css,html,json}": "prettier --write",
    "*.ts": "eslint --fix"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.3.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.0.4",
    "msw": "^2.7.0",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@milkdown/crepe": "^7.22.0",
    "@milkdown/kit": "^7.22.0",
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "dexie": "^4.4.4"
  }
}
